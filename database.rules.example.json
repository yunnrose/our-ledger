{
  "rules": {
    ".read": false,
    ".write": false,
    "members": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "transactions": {
      ".read": "auth != null && (auth.uid === 'REPLACE_PEIJUN_UID' || auth.uid === 'REPLACE_BENSON_UID')",
      ".write": "auth != null && (auth.uid === 'REPLACE_PEIJUN_UID' || auth.uid === 'REPLACE_BENSON_UID')"
    },
    "logs": {
      ".read": "auth != null && (auth.uid === 'REPLACE_PEIJUN_UID' || auth.uid === 'REPLACE_BENSON_UID')",
      ".write": "auth != null && (auth.uid === 'REPLACE_PEIJUN_UID' || auth.uid === 'REPLACE_BENSON_UID')"
    }
  }
}
